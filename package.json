{
  "name": "nimbus",
  "version": "0.1.0",
  "private": true,
  "description": "Self-hosted feature flag and experimentation platform",
  "license": "MIT",
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "build": "pnpm -r run build",
    "dev": "pnpm --filter @nimbus/server run dev",
    "dev:admin": "pnpm --filter @nimbus/admin run dev",
    "test": "pnpm -r run test",
    "typecheck": "pnpm -r run typecheck",
    "lint": "pnpm -r run lint",
    "db:up": "docker compose up -d postgres redis",
    "db:down": "docker compose down"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
